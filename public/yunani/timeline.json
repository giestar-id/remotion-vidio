{
  "audio": "yunani/voiceover.wav",
  "audioDurationMs": 804000,
  "totalDurationMs": 804000,
  "scenes": [
    {
      "index": 1,
      "id": 1,
      "image": "yunani/scene-1.jpg",
      "startMs": 0,
      "endMs": 8600,
      "durationMs": 8600,
      "transition": "none",
      "text": "Tahun 483 Sebelum Masehi, di bukit berbatu Laurion dekat Athena,"
    },
    {
      "index": 2,
      "id": 2,
      "image": "yunani/scene-2.jpg",
      "startMs": 8600,
      "endMs": 15230,
      "durationMs": 6630,
      "transition": "none",
      "text": "seorang penambang menghantam batu karang dan menemukan urat perak tebal."
    },
    {
      "index": 3,
      "id": 3,
      "image": "yunani/scene-3.jpg",
      "startMs": 15230,
      "endMs": 23750,
      "durationMs": 8520,
      "transition": "none",
      "text": "Nilainya sekitar 100 talenta perak. Jumlah ini sanggup membuat"
    },
    {
      "index": 4,
      "id": 4,
      "image": "yunani/scene-4.jpg",
      "startMs": 23750,
      "endMs": 25750,
      "durationMs": 2000,
      "transition": "none",
      "text": "seluruh warga kaya mendadak. Namun, politisi bernama Themistocles melarang"
    },
    {
      "index": 5,
      "id": 5,
      "image": "yunani/scene-5.jpg",
      "startMs": 25750,
      "endMs": 30590,
      "durationMs": 4840,
      "transition": "none",
      "text": "uang itu dibagi-bagikan. Dia meyakinkan warga untuk memakai seluruh"
    },
    {
      "index": 6,
      "id": 6,
      "image": "yunani/scene-6.jpg",
      "startMs": 30590,
      "endMs": 33420,
      "durationMs": 2830,
      "transition": "none",
      "text": "perak demi membiayai dua ratus kapal perang trireme."
    },
    {
      "index": 7,
      "id": 7,
      "image": "yunani/scene-7.jpg",
      "startMs": 33420,
      "endMs": 37250,
      "durationMs": 3830,
      "transition": "none",
      "text": "Keputusan nekat ini kelak menyelamatkan Yunani dari kepunahan."
    },
    {
      "index": 8,
      "id": 8,
      "image": "yunani/scene-8.jpg",
      "startMs": 37250,
      "endMs": 41860,
      "durationMs": 4610,
      "transition": "none",
      "text": "Peradaban besar tidak selalu lahir dari lembah subur."
    },
    {
      "index": 9,
      "id": 9,
      "image": "yunani/scene-9.jpg",
      "startMs": 41860,
      "endMs": 45840,
      "durationMs": 3980,
      "transition": "none",
      "text": "Bangsa Yunani membangun dunia dari batu karang tandus,"
    },
    {
      "index": 10,
      "id": 10,
      "image": "yunani/scene-10.jpg",
      "startMs": 45840,
      "endMs": 50140,
      "durationMs": 4300,
      "transition": "none",
      "text": "kelangkaan pangan, dan ancaman maut yang selalu mengintai."
    },
    {
      "index": 11,
      "id": 11,
      "image": "yunani/scene-11.jpg",
      "startMs": 50140,
      "endMs": 54880,
      "durationMs": 4740,
      "transition": "none",
      "text": "Ini adalah kisah bagaimana kepingan perak dari bukit berbatu"
    },
    {
      "index": 12,
      "id": 12,
      "image": "yunani/scene-12.jpg",
      "startMs": 54880,
      "endMs": 60680,
      "durationMs": 5800,
      "transition": "none",
      "text": "menjelma menjadi armada pelindung, melahirkan kedaulatan rakyat pertama,"
    },
    {
      "index": 13,
      "id": 13,
      "image": "yunani/scene-13.jpg",
      "startMs": 60680,
      "endMs": 66360,
      "durationMs": 5680,
      "transition": "none",
      "text": "meledak melintasi benua, lalu menaklukkan pikiran para penakluknya sendiri."
    },
    {
      "index": 14,
      "id": 14,
      "image": "yunani/scene-14.jpg",
      "startMs": 66360,
      "endMs": 71360,
      "durationMs": 5000,
      "transition": "none",
      "text": "Yang kita tahu, Yunani pada mulanya bukanlah negara kesatuan."
    },
    {
      "index": 15,
      "id": 15,
      "image": "yunani/scene-15.jpg",
      "startMs": 71360,
      "endMs": 75480,
      "durationMs": 4120,
      "transition": "none",
      "text": "Wilayahnya terpecah oleh barisan gunung terjal dan ribuan teluk"
    },
    {
      "index": 16,
      "id": 16,
      "image": "yunani/scene-16.jpg",
      "startMs": 75480,
      "endMs": 76840,
      "durationMs": 1360,
      "transition": "none",
      "text": "sempit di Laut Aegea. Alam yang keras memaksa mereka"
    },
    {
      "index": 17,
      "id": 17,
      "image": "yunani/scene-17.jpg",
      "startMs": 76840,
      "endMs": 83950,
      "durationMs": 7110,
      "transition": "none",
      "text": "hidup terisolasi dalam komunitas mandiri bernama polis. Artinya, negara-kota."
    },
    {
      "index": 18,
      "id": 18,
      "image": "yunani/scene-18.jpg",
      "startMs": 83950,
      "endMs": 88900,
      "durationMs": 4950,
      "transition": "none",
      "text": "Setiap polis memiliki hukum, dewa pelindung, dan mata uang sendiri."
    },
    {
      "index": 19,
      "id": 19,
      "image": "yunani/scene-19.jpg",
      "startMs": 88900,
      "endMs": 92480,
      "durationMs": 3580,
      "transition": "none",
      "text": "Mereka terus bersaing memperebutkan petak gandum sempit."
    },
    {
      "index": 20,
      "id": 20,
      "image": "yunani/scene-20.jpg",
      "startMs": 92480,
      "endMs": 96700,
      "durationMs": 4220,
      "transition": "none",
      "text": "Kala itu, hidup petani bebas sangat rapuh. Sekali gagal panen,"
    },
    {
      "index": 21,
      "id": 21,
      "image": "yunani/scene-21.jpg",
      "startMs": 96700,
      "endMs": 104610,
      "durationMs": 7910,
      "transition": "none",
      "text": "satu keluarga bisa langsung diperbudak untuk melunasi utang pangan."
    },
    {
      "index": 22,
      "id": 22,
      "image": "yunani/scene-22.jpg",
      "startMs": 104610,
      "endMs": 110520,
      "durationMs": 5910,
      "transition": "none",
      "text": "Sekitar 594 Sebelum Masehi, jurang kemiskinan di Athena nyaris menyulut"
    },
    {
      "index": 23,
      "id": 23,
      "image": "yunani/scene-23.jpg",
      "startMs": 110520,
      "endMs": 113140,
      "durationMs": 2620,
      "transition": "none",
      "text": "perang saudara. Bangsawan menguasai tanah, sementara rakyat tercekik utang."
    },
    {
      "index": 24,
      "id": 24,
      "image": "yunani/scene-24.jpg",
      "startMs": 113140,
      "endMs": 117800,
      "durationMs": 4660,
      "transition": "none",
      "text": "Demi mencegah pertumpahan darah, mereka menunjuk Solon merombak hukum."
    },
    {
      "index": 25,
      "id": 25,
      "image": "yunani/scene-25.jpg",
      "startMs": 117800,
      "endMs": 124060,
      "durationMs": 6260,
      "transition": "none",
      "text": "Solon mencabut batu penanda utang di ladang serta memerdekakan"
    },
    {
      "index": 26,
      "id": 26,
      "image": "yunani/scene-26.jpg",
      "startMs": 124060,
      "endMs": 126740,
      "durationMs": 2680,
      "transition": "none",
      "text": "warga yang diperbudak. Tindakan ini disebut seisachtheia. Artinya,"
    },
    {
      "index": 27,
      "id": 27,
      "image": "yunani/scene-27.jpg",
      "startMs": 126740,
      "endMs": 132970,
      "durationMs": 6230,
      "transition": "none",
      "text": "pelepasan beban yang mengguncang. Dia melarang pinjaman berjaminan tubuh manusia."
    },
    {
      "index": 28,
      "id": 28,
      "image": "yunani/scene-28.jpg",
      "startMs": 132970,
      "endMs": 138450,
      "durationMs": 5480,
      "transition": "none",
      "text": "Solon tidak membagikan tanah orang kaya, tetapi membuka pintu rapat"
    },
    {
      "index": 29,
      "id": 29,
      "image": "yunani/scene-29.jpg",
      "startMs": 138450,
      "endMs": 141640,
      "durationMs": 3190,
      "transition": "none",
      "text": "umum bagi seluruh warga. Tapi sebelum sampai ke sana,"
    },
    {
      "index": 30,
      "id": 30,
      "image": "yunani/scene-30.jpg",
      "startMs": 141640,
      "endMs": 147620,
      "durationMs": 5980,
      "transition": "none",
      "text": "para elit masih menyimpan dendam lama. Sekitar 508 Sebelum Masehi,"
    },
    {
      "index": 31,
      "id": 31,
      "image": "yunani/scene-31.jpg",
      "startMs": 147620,
      "endMs": 155280,
      "durationMs": 7660,
      "transition": "none",
      "text": "perebutan kekuasaan antarbangsawan memuncak lagi. Di sinilah ceritanya berubah."
    },
    {
      "index": 32,
      "id": 32,
      "image": "yunani/scene-32.jpg",
      "startMs": 155280,
      "endMs": 160320,
      "durationMs": 5040,
      "transition": "none",
      "text": "Bangsawan bernama Cleisthenes mengambil langkah tanpa tandingan. Dia membubarkan empat"
    },
    {
      "index": 33,
      "id": 33,
      "image": "yunani/scene-33.jpg",
      "startMs": 160320,
      "endMs": 167620,
      "durationMs": 7300,
      "transition": "none",
      "text": "suku aristokrat lama dan membentuk sepuluh suku baru buatan."
    },
    {
      "index": 34,
      "id": 34,
      "image": "yunani/scene-34.jpg",
      "startMs": 167620,
      "endMs": 172140,
      "durationMs": 4520,
      "transition": "none",
      "text": "Mekanisme ini bekerja rapi meredam permusuhan antargolongan."
    },
    {
      "index": 35,
      "id": 35,
      "image": "yunani/scene-35.jpg",
      "startMs": 172140,
      "endMs": 177630,
      "durationMs": 5490,
      "transition": "none",
      "text": "Wilayah Athena dibagi tiga zona: pesisir, pedalaman, dan kota. Tiap"
    },
    {
      "index": 36,
      "id": 36,
      "image": "yunani/scene-36.jpg",
      "startMs": 177630,
      "endMs": 182240,
      "durationMs": 4610,
      "transition": "none",
      "text": "suku baru wajib berisi gabungan warga dari ketiga zona tersebut."
    },
    {
      "index": 37,
      "id": 37,
      "image": "yunani/scene-37.jpg",
      "startMs": 182240,
      "endMs": 186900,
      "durationMs": 4660,
      "transition": "none",
      "text": "Ibarat menyatukan serpihan tulang, otot, dan kulit tubuh agar"
    },
    {
      "index": 38,
      "id": 38,
      "image": "yunani/scene-38.jpg",
      "startMs": 186900,
      "endMs": 190720,
      "durationMs": 3820,
      "transition": "none",
      "text": "bergerak serempak di bawah satu kesadaran. Mereka yang dulunya"
    },
    {
      "index": 39,
      "id": 39,
      "image": "yunani/scene-39.jpg",
      "startMs": 190720,
      "endMs": 196560,
      "durationMs": 5840,
      "transition": "none",
      "text": "bermusuhan dipaksa duduk berdampingan mengurus pertahanan dan anggaran kota."
    },
    {
      "index": 40,
      "id": 40,
      "image": "yunani/scene-40.jpg",
      "startMs": 196560,
      "endMs": 201670,
      "durationMs": 5110,
      "transition": "none",
      "text": "Dewan lima ratus orang dibentuk lewat undian acak berkala. Siapa"
    },
    {
      "index": 41,
      "id": 41,
      "image": "yunani/scene-41.jpg",
      "startMs": 201670,
      "endMs": 206510,
      "durationMs": 4840,
      "transition": "none",
      "text": "pun pria merdeka punya peluang setara memimpin selama satu tahun."
    },
    {
      "index": 42,
      "id": 42,
      "image": "yunani/scene-42.jpg",
      "startMs": 206510,
      "endMs": 212760,
      "durationMs": 6250,
      "transition": "none",
      "text": "Mereka menamainya isonomia. Artinya, kesetaraan hak di hadapan hukum."
    },
    {
      "index": 43,
      "id": 43,
      "image": "yunani/scene-43.jpg",
      "startMs": 212760,
      "endMs": 219180,
      "durationMs": 6420,
      "transition": "none",
      "text": "Gagasan ini menjadi benih awal pemerintahan yang kita sebut demokrasi."
    },
    {
      "index": 44,
      "id": 44,
      "image": "yunani/scene-44.jpg",
      "startMs": 219180,
      "endMs": 223830,
      "durationMs": 4650,
      "transition": "none",
      "text": "Namun, tepat saat Athena mulai memperdebatkan undang-undang secara terbuka,"
    },
    {
      "index": 45,
      "id": 45,
      "image": "yunani/scene-45.jpg",
      "startMs": 223830,
      "endMs": 229470,
      "durationMs": 5640,
      "transition": "none",
      "text": "ancaman raksasa datang dari timur. Kekaisaran Persia bertekad menundukkan"
    },
    {
      "index": 46,
      "id": 46,
      "image": "yunani/scene-46.jpg",
      "startMs": 229470,
      "endMs": 234690,
      "durationMs": 5220,
      "transition": "none",
      "text": "Yunani akibat campur tangan Athena dalam pemberontakan Ionia."
    },
    {
      "index": 47,
      "id": 47,
      "image": "yunani/scene-47.jpg",
      "startMs": 234690,
      "endMs": 239790,
      "durationMs": 5100,
      "transition": "none",
      "text": "Pasukan Persia dipukul mundur oleh tombak Athena di Marathon pada"
    },
    {
      "index": 48,
      "id": 48,
      "image": "yunani/scene-48.jpg",
      "startMs": 239790,
      "endMs": 243570,
      "durationMs": 3780,
      "transition": "none",
      "text": "490 Sebelum Masehi. Sepuluh tahun berselang, putranya, Raja Xerxes,"
    },
    {
      "index": 49,
      "id": 49,
      "image": "yunani/scene-49.jpg",
      "startMs": 243570,
      "endMs": 248090,
      "durationMs": 4520,
      "transition": "none",
      "text": "memimpin ekspedisi kedua dengan skala jauh lebih mengerikan."
    },
    {
      "index": 50,
      "id": 50,
      "image": "yunani/scene-50.jpg",
      "startMs": 248090,
      "endMs": 255410,
      "durationMs": 7320,
      "transition": "none",
      "text": "Ratusan ribu prajurit dan ribuan kapal bergerak menyapu wilayah utara."
    },
    {
      "index": 51,
      "id": 51,
      "image": "yunani/scene-51.jpg",
      "startMs": 255410,
      "endMs": 257770,
      "durationMs": 2360,
      "transition": "none",
      "text": "Di celah sempit Thermopylae, Raja Leonidas bersama tiga ratus prajurit"
    },
    {
      "index": 52,
      "id": 52,
      "image": "yunani/scene-52.jpg",
      "startMs": 257770,
      "endMs": 263620,
      "durationMs": 5850,
      "transition": "none",
      "text": "Sparta bertarung sampai gugur demi mengulur waktu mundur bagi sekutu."
    },
    {
      "index": 53,
      "id": 53,
      "image": "yunani/scene-53.jpg",
      "startMs": 263620,
      "endMs": 268080,
      "durationMs": 4460,
      "transition": "none",
      "text": "Pengorbanan itu heroik, tetapi pertahanan darat tetap bobol."
    },
    {
      "index": 54,
      "id": 54,
      "image": "yunani/scene-54.jpg",
      "startMs": 268080,
      "endMs": 271400,
      "durationMs": 3320,
      "transition": "none",
      "text": "Pasukan Persia merangsek masuk ke Athena dan membakar kuil"
    },
    {
      "index": 55,
      "id": 55,
      "image": "yunani/scene-55.jpg",
      "startMs": 271400,
      "endMs": 276880,
      "durationMs": 5480,
      "transition": "none",
      "text": "Akropolis menjadi abu hitam. Dan itu belum yang terburuk."
    },
    {
      "index": 56,
      "id": 56,
      "image": "yunani/scene-56.jpg",
      "startMs": 276880,
      "endMs": 281380,
      "durationMs": 4500,
      "transition": "none",
      "text": "Melihat kotanya hangus, Themistocles tak menyerah. Dia mengarahkan warga mengungsi"
    },
    {
      "index": 57,
      "id": 57,
      "image": "yunani/scene-57.jpg",
      "startMs": 281380,
      "endMs": 285320,
      "durationMs": 3940,
      "transition": "none",
      "text": "ke Pulau Salamis dan mempertaruhkan nasib pada dinding kayu: dua"
    },
    {
      "index": 58,
      "id": 58,
      "image": "yunani/scene-58.jpg",
      "startMs": 285320,
      "endMs": 291410,
      "durationMs": 6090,
      "transition": "none",
      "text": "ratus kapal trireme dari perak Laurion. Themistocles menyusun perangkap licik."
    },
    {
      "index": 59,
      "id": 59,
      "image": "yunani/scene-59.jpg",
      "startMs": 291410,
      "endMs": 297450,
      "durationMs": 6040,
      "transition": "none",
      "text": "Dia mengirim budak kepercayaannya membawa pesan rahasia palsu kepada Xerxes"
    },
    {
      "index": 60,
      "id": 60,
      "image": "yunani/scene-60.jpg",
      "startMs": 297450,
      "endMs": 302970,
      "durationMs": 5520,
      "transition": "none",
      "text": "bahwa pasukan Yunani sedang panik dan bersiap melarikan diri lewat"
    },
    {
      "index": 61,
      "id": 61,
      "image": "yunani/scene-61.jpg",
      "startMs": 302970,
      "endMs": 310030,
      "durationMs": 7060,
      "transition": "none",
      "text": "selat. Tergiur kemenangan kilat, Xerxes memerintahkan armadanya mengepung Selat Salamis"
    },
    {
      "index": 62,
      "id": 62,
      "image": "yunani/scene-62.jpg",
      "startMs": 310030,
      "endMs": 312650,
      "durationMs": 2620,
      "transition": "none",
      "text": "pada malam hari. Di lorong laut inilah taktik perang bekerja."
    },
    {
      "index": 63,
      "id": 63,
      "image": "yunani/scene-63.jpg",
      "startMs": 312650,
      "endMs": 316310,
      "durationMs": 3660,
      "transition": "none",
      "text": "Kapal trireme Yunani memiliki lambung ramping dengan tiga"
    },
    {
      "index": 64,
      "id": 64,
      "image": "yunani/scene-64.jpg",
      "startMs": 316310,
      "endMs": 320080,
      "durationMs": 3770,
      "transition": "none",
      "text": "tingkat dayung yang dikayuh seratus tujuh puluh pendayung."
    },
    {
      "index": 65,
      "id": 65,
      "image": "yunani/scene-65.jpg",
      "startMs": 320080,
      "endMs": 326230,
      "durationMs": 6150,
      "transition": "none",
      "text": "Haluan kapal dipasangi moncong perunggu tajam. Saat kapal Persia yang"
    },
    {
      "index": 66,
      "id": 66,
      "image": "yunani/scene-66.jpg",
      "startMs": 326230,
      "endMs": 329340,
      "durationMs": 3110,
      "transition": "none",
      "text": "tambun berdesakan di selat sempit, gerak mereka terkunci rapat."
    },
    {
      "index": 67,
      "id": 67,
      "image": "yunani/scene-67.jpg",
      "startMs": 329340,
      "endMs": 334290,
      "durationMs": 4950,
      "transition": "none",
      "text": "Ibarat rombongan truk muatan berat tersangkut di gang perkampungan,"
    },
    {
      "index": 68,
      "id": 68,
      "image": "yunani/scene-68.jpg",
      "startMs": 334290,
      "endMs": 338570,
      "durationMs": 4280,
      "transition": "none",
      "text": "mereka saling menabrak dan mematahkan dayung sendiri. Kapal trireme lincah"
    },
    {
      "index": 69,
      "id": 69,
      "image": "yunani/scene-69.jpg",
      "startMs": 338570,
      "endMs": 342370,
      "durationMs": 3800,
      "transition": "none",
      "text": "melesat, menghantam lambung lawan hingga remuk. Di atas bukit,"
    },
    {
      "index": 70,
      "id": 70,
      "image": "yunani/scene-70.jpg",
      "startMs": 342370,
      "endMs": 348300,
      "durationMs": 5930,
      "transition": "none",
      "text": "Xerxes terpaksa menyaksikan armadanya tenggelam ke dasar laut. Kemenangan di"
    },
    {
      "index": 71,
      "id": 71,
      "image": "yunani/scene-71.jpg",
      "startMs": 348300,
      "endMs": 355940,
      "durationMs": 7640,
      "transition": "none",
      "text": "Salamis dan pertempuran Plataea pada tahun berikutnya berhasil mengusir Persia."
    },
    {
      "index": 72,
      "id": 72,
      "image": "yunani/scene-72.jpg",
      "startMs": 355940,
      "endMs": 361020,
      "durationMs": 5080,
      "transition": "none",
      "text": "Athena melonjak menjadi pemimpin persekutuan laut yang makmur dan ditakuti."
    },
    {
      "index": 73,
      "id": 73,
      "image": "yunani/scene-73.jpg",
      "startMs": 361020,
      "endMs": 363980,
      "durationMs": 2960,
      "transition": "none",
      "text": "Sekarang kita berhenti sejenak melihat posisi Yunani di titik tengah"
    },
    {
      "index": 74,
      "id": 74,
      "image": "yunani/scene-74.jpg",
      "startMs": 363980,
      "endMs": 368080,
      "durationMs": 4100,
      "transition": "none",
      "text": "sejarah. Puncak kejayaan diraih dan penjajah terusir, tetapi benih kehancuran"
    },
    {
      "index": 75,
      "id": 75,
      "image": "yunani/scene-75.jpg",
      "startMs": 368080,
      "endMs": 373540,
      "durationMs": 5460,
      "transition": "none",
      "text": "bertunas dari dada bangsa ini sendiri. Di satu sudut berdiri"
    },
    {
      "index": 76,
      "id": 76,
      "image": "yunani/scene-76.jpg",
      "startMs": 373540,
      "endMs": 378820,
      "durationMs": 5280,
      "transition": "none",
      "text": "Athena, kota laut yang kaya seni dan debat filsafat. Di"
    },
    {
      "index": 77,
      "id": 77,
      "image": "yunani/scene-77.jpg",
      "startMs": 378820,
      "endMs": 382400,
      "durationMs": 3580,
      "transition": "none",
      "text": "sudut lain berdiri Sparta, kekuatan darat dengan reputasi militer legendaris."
    },
    {
      "index": 78,
      "id": 78,
      "image": "yunani/scene-78.jpg",
      "startMs": 382400,
      "endMs": 386580,
      "durationMs": 4180,
      "transition": "none",
      "text": "Banyak orang mengira Sparta bangsa prajurit super yang kebal kekalahan."
    },
    {
      "index": 79,
      "id": 79,
      "image": "yunani/scene-79.jpg",
      "startMs": 386580,
      "endMs": 390480,
      "durationMs": 3900,
      "transition": "none",
      "text": "Namun, catatan sejarah membuka kenyataan berbanding terbalik. Para sejarawan menyebut"
    },
    {
      "index": 80,
      "id": 80,
      "image": "yunani/scene-80.jpg",
      "startMs": 390480,
      "endMs": 395740,
      "durationMs": 5260,
      "transition": "none",
      "text": "tabir kehebatan ini sebagai Ilusi Sparta. Di balik zirah perunggu"
    },
    {
      "index": 81,
      "id": 81,
      "image": "yunani/scene-81.jpg",
      "startMs": 395740,
      "endMs": 401630,
      "durationMs": 5890,
      "transition": "none",
      "text": "perkasa, masyarakat Sparta digerogoti penyakit sosial mematikan bernama oliganthropia."
    },
    {
      "index": 82,
      "id": 82,
      "image": "yunani/scene-82.jpg",
      "startMs": 401630,
      "endMs": 408650,
      "durationMs": 7020,
      "transition": "none",
      "text": "Artinya, penyusutan drastis jumlah penduduk merdeka. Sistem sosial Sparta luar"
    },
    {
      "index": 83,
      "id": 83,
      "image": "yunani/scene-83.jpg",
      "startMs": 408650,
      "endMs": 411980,
      "durationMs": 3330,
      "transition": "none",
      "text": "biasa kaku. Untuk mempertahankan status warga penuh, seorang pria wajib"
    },
    {
      "index": 84,
      "id": 84,
      "image": "yunani/scene-84.jpg",
      "startMs": 411980,
      "endMs": 417200,
      "durationMs": 5220,
      "transition": "none",
      "text": "lulus pelatihan brutal agoge dan menyetor makanan ke perjamuan bersama."
    },
    {
      "index": 85,
      "id": 85,
      "image": "yunani/scene-85.jpg",
      "startMs": 417200,
      "endMs": 420740,
      "durationMs": 3540,
      "transition": "none",
      "text": "Bila prajurit jatuh miskin, hak warganya langsung dicabut."
    },
    {
      "index": 86,
      "id": 86,
      "image": "yunani/scene-86.jpg",
      "startMs": 420740,
      "endMs": 426050,
      "durationMs": 5310,
      "transition": "none",
      "text": "Ditambah gempa bumi dahsyat tahun 464 Sebelum Masehi serta"
    },
    {
      "index": 87,
      "id": 87,
      "image": "yunani/scene-87.jpg",
      "startMs": 426050,
      "endMs": 430620,
      "durationMs": 4570,
      "transition": "none",
      "text": "sikap menutup diri, populasi inti mereka menyusut drastis."
    },
    {
      "index": 88,
      "id": 88,
      "image": "yunani/scene-88.jpg",
      "startMs": 430620,
      "endMs": 433880,
      "durationMs": 3260,
      "transition": "none",
      "text": "Dari delapan ribu prajurit di awal perang Persia,"
    },
    {
      "index": 89,
      "id": 89,
      "image": "yunani/scene-89.jpg",
      "startMs": 433880,
      "endMs": 438780,
      "durationMs": 4900,
      "transition": "none",
      "text": "jumlahnya merosot hingga tersisa kurang dari seribu orang seabad kemudian."
    },
    {
      "index": 90,
      "id": 90,
      "image": "yunani/scene-90.jpg",
      "startMs": 438780,
      "endMs": 442920,
      "durationMs": 4140,
      "transition": "none",
      "text": "Sparta beroperasi mirip perkumpulan elit yang terus membuang anggotanya"
    },
    {
      "index": 91,
      "id": 91,
      "image": "yunani/scene-91.jpg",
      "startMs": 442920,
      "endMs": 449190,
      "durationMs": 6270,
      "transition": "none",
      "text": "sendiri sampai tak ada lagi prajurit di medan laga."
    },
    {
      "index": 92,
      "id": 92,
      "image": "yunani/scene-92.jpg",
      "startMs": 449190,
      "endMs": 455910,
      "durationMs": 6720,
      "transition": "none",
      "text": "Kecemasan Sparta melihat kekayaan laut Athena akhirnya menyulut Perang Peloponnesos"
    },
    {
      "index": 93,
      "id": 93,
      "image": "yunani/scene-93.jpg",
      "startMs": 455910,
      "endMs": 460140,
      "durationMs": 4230,
      "transition": "none",
      "text": "pada 431 Sebelum Masehi. Perang saudara ini berkecamuk selama dua"
    },
    {
      "index": 94,
      "id": 94,
      "image": "yunani/scene-94.jpg",
      "startMs": 460140,
      "endMs": 464760,
      "durationMs": 4620,
      "transition": "none",
      "text": "puluh tujuh tahun. Athena berlindung di balik tembok panjang sambil"
    },
    {
      "index": 95,
      "id": 95,
      "image": "yunani/scene-95.jpg",
      "startMs": 464760,
      "endMs": 466880,
      "durationMs": 2120,
      "transition": "none",
      "text": "mengandalkan suplai laut. Namun, wabah penyakit menyerang dari dalam,"
    },
    {
      "index": 96,
      "id": 96,
      "image": "yunani/scene-96.jpg",
      "startMs": 466880,
      "endMs": 472420,
      "durationMs": 5540,
      "transition": "none",
      "text": "membunuh sepertiga penduduk termasuk pemimpin mereka, Pericles."
    },
    {
      "index": 97,
      "id": 97,
      "image": "yunani/scene-97.jpg",
      "startMs": 472420,
      "endMs": 477980,
      "durationMs": 5560,
      "transition": "none",
      "text": "Ambisi Athena hancur setelah ekspedisi militer ke Sisilia musnah dibantai."
    },
    {
      "index": 98,
      "id": 98,
      "image": "yunani/scene-98.jpg",
      "startMs": 477980,
      "endMs": 483080,
      "durationMs": 5100,
      "transition": "none",
      "text": "Dibantu kucuran emas Persia, Sparta akhirnya membangun armada laut dan"
    },
    {
      "index": 99,
      "id": 99,
      "image": "yunani/scene-99.jpg",
      "startMs": 483080,
      "endMs": 487000,
      "durationMs": 3920,
      "transition": "none",
      "text": "menghancurkan sisa kapal Athena di Aegospotami pada 405 Sebelum Masehi."
    },
    {
      "index": 100,
      "id": 100,
      "image": "yunani/scene-100.jpg",
      "startMs": 487000,
      "endMs": 493280,
      "durationMs": 6280,
      "transition": "none",
      "text": "Athena menyerah karena kelaparan. Tembok pertahanannya dirobohkan. Kemenangan Sparta"
    },
    {
      "index": 101,
      "id": 101,
      "image": "yunani/scene-101.jpg",
      "startMs": 493280,
      "endMs": 499910,
      "durationMs": 6630,
      "transition": "none",
      "text": "berumur sangat pendek. Ketiadaan prajurit membuat kepemimpinan mereka rapuh."
    },
    {
      "index": 102,
      "id": 102,
      "image": "yunani/scene-102.jpg",
      "startMs": 499910,
      "endMs": 504520,
      "durationMs": 4610,
      "transition": "none",
      "text": "Pada 371 Sebelum Masehi di Leuktra, pasukan Thebes melancarkan"
    },
    {
      "index": 103,
      "id": 103,
      "image": "yunani/scene-103.jpg",
      "startMs": 504520,
      "endMs": 509140,
      "durationMs": 4620,
      "transition": "none",
      "text": "taktik formasi miring yang meremukkan barisan elit Sparta."
    },
    {
      "index": 104,
      "id": 104,
      "image": "yunani/scene-104.jpg",
      "startMs": 509140,
      "endMs": 516290,
      "durationMs": 7150,
      "transition": "none",
      "text": "Wilayah budak Messenia yang ratusan tahun menopang ekonomi Sparta dibebaskan."
    },
    {
      "index": 105,
      "id": 105,
      "image": "yunani/scene-105.jpg",
      "startMs": 516290,
      "endMs": 520430,
      "durationMs": 4140,
      "transition": "none",
      "text": "Sparta terpuruk menjadi desa pedalaman dan tidak pernah bangkit lagi."
    },
    {
      "index": 106,
      "id": 106,
      "image": "yunani/scene-106.jpg",
      "startMs": 520430,
      "endMs": 525880,
      "durationMs": 5450,
      "transition": "none",
      "text": "Seluruh tanah Yunani kini luluh lantak, bangkrut,"
    },
    {
      "index": 107,
      "id": 107,
      "image": "yunani/scene-107.jpg",
      "startMs": 525880,
      "endMs": 527770,
      "durationMs": 1890,
      "transition": "none",
      "text": "dan saling mencurigai. Di titik nadir inilah,"
    },
    {
      "index": 108,
      "id": 108,
      "image": "yunani/scene-108.jpg",
      "startMs": 527770,
      "endMs": 532360,
      "durationMs": 4590,
      "transition": "none",
      "text": "ancaman baru muncul dari perbatasan utara berhutan lebat. Kerajaan Makedonia,"
    },
    {
      "index": 109,
      "id": 109,
      "image": "yunani/scene-109.jpg",
      "startMs": 532360,
      "endMs": 537480,
      "durationMs": 5120,
      "transition": "none",
      "text": "wilayah pegunungan yang kerap dicap setengah barbar oleh orang Athena,"
    },
    {
      "index": 110,
      "id": 110,
      "image": "yunani/scene-110.jpg",
      "startMs": 537480,
      "endMs": 541240,
      "durationMs": 3760,
      "transition": "none",
      "text": "bangkit pesat di bawah komando Raja Philip II."
    },
    {
      "index": 111,
      "id": 111,
      "image": "yunani/scene-111.jpg",
      "startMs": 541240,
      "endMs": 547220,
      "durationMs": 5980,
      "transition": "none",
      "text": "Philip merevolusi formasi tempur dengan sarissa, tombak kayu sepanjang"
    },
    {
      "index": 112,
      "id": 112,
      "image": "yunani/scene-112.jpg",
      "startMs": 547220,
      "endMs": 552340,
      "durationMs": 5120,
      "transition": "none",
      "text": "enam meter. Pada 338 Sebelum Masehi di Chaeronea,"
    },
    {
      "index": 113,
      "id": 113,
      "image": "yunani/scene-113.jpg",
      "startMs": 552340,
      "endMs": 560260,
      "durationMs": 7920,
      "transition": "none",
      "text": "Philip menundukkan gabungan tentara Athena dan Thebes. Zaman kemandirian negara-kota"
    },
    {
      "index": 114,
      "id": 114,
      "image": "yunani/scene-114.jpg",
      "startMs": 560260,
      "endMs": 561930,
      "durationMs": 1670,
      "transition": "none",
      "text": "Yunani resmi tamat. Dua tahun kemudian, Philip tewas dibunuh."
    },
    {
      "index": 115,
      "id": 115,
      "image": "yunani/scene-115.jpg",
      "startMs": 561930,
      "endMs": 567140,
      "durationMs": 5210,
      "transition": "none",
      "text": "Putranya yang berumur dua puluh tahun, Alexander, mengambil alih tahta."
    },
    {
      "index": 116,
      "id": 116,
      "image": "yunani/scene-116.jpg",
      "startMs": 567140,
      "endMs": 571080,
      "durationMs": 3940,
      "transition": "none",
      "text": "Alexander menyeberang ke Asia membawa satu tekad mutlak:"
    },
    {
      "index": 117,
      "id": 117,
      "image": "yunani/scene-117.jpg",
      "startMs": 571080,
      "endMs": 578620,
      "durationMs": 7540,
      "transition": "none",
      "text": "menumbangkan Kekaisaran Persia. Lewat kecepatan manuver pasukan berkuda di Granicus,"
    },
    {
      "index": 118,
      "id": 118,
      "image": "yunani/scene-118.jpg",
      "startMs": 578620,
      "endMs": 585200,
      "durationMs": 6580,
      "transition": "none",
      "text": "Issus, dan Gaugamela, Alexander menumbangkan kekuasaan raja Persia."
    },
    {
      "index": 119,
      "id": 119,
      "image": "yunani/scene-119.jpg",
      "startMs": 585200,
      "endMs": 591840,
      "durationMs": 6640,
      "transition": "none",
      "text": "Pasukannya merebut Mesir, mendirikan kota Alexandria, lalu membakar istana Persepolis."
    },
    {
      "index": 120,
      "id": 120,
      "image": "yunani/scene-120.jpg",
      "startMs": 591840,
      "endMs": 595750,
      "durationMs": 3910,
      "transition": "none",
      "text": "Dahaga ekspansinya tak pernah padam melintasi ribuan mil padang"
    },
    {
      "index": 121,
      "id": 121,
      "image": "yunani/scene-121.jpg",
      "startMs": 595750,
      "endMs": 601220,
      "durationMs": 5470,
      "transition": "none",
      "text": "gurun sampai tiba di tepi Sungai Hyphasis di India."
    },
    {
      "index": 122,
      "id": 122,
      "image": "yunani/scene-122.jpg",
      "startMs": 601220,
      "endMs": 606070,
      "durationMs": 4850,
      "transition": "none",
      "text": "Di tepian sungai inilah prajuritnya yang letih menolak melangkah lebih"
    },
    {
      "index": 123,
      "id": 123,
      "image": "yunani/scene-123.jpg",
      "startMs": 606070,
      "endMs": 610080,
      "durationMs": 4010,
      "transition": "none",
      "text": "jauh. Alexander mendirikan dua belas altar batu raksasa penanda"
    },
    {
      "index": 124,
      "id": 124,
      "image": "yunani/scene-124.jpg",
      "startMs": 610080,
      "endMs": 615510,
      "durationMs": 5430,
      "transition": "none",
      "text": "batas akhir dunia yang dikenalnya, lalu memutar haluan pulang."
    },
    {
      "index": 125,
      "id": 125,
      "image": "yunani/scene-125.jpg",
      "startMs": 615510,
      "endMs": 620210,
      "durationMs": 4700,
      "transition": "none",
      "text": "Sang penakluk muda wafat di Babilonia pada tahun 323"
    },
    {
      "index": 126,
      "id": 126,
      "image": "yunani/scene-126.jpg",
      "startMs": 620210,
      "endMs": 624400,
      "durationMs": 4190,
      "transition": "none",
      "text": "Sebelum Masehi dalam usia tiga puluh dua tahun."
    },
    {
      "index": 127,
      "id": 127,
      "image": "yunani/scene-127.jpg",
      "startMs": 624400,
      "endMs": 629630,
      "durationMs": 5230,
      "transition": "none",
      "text": "Kematian mendadak tanpa pewaris sah meninggalkan lubang kekuasaan menganga. Para"
    },
    {
      "index": 128,
      "id": 128,
      "image": "yunani/scene-128.jpg",
      "startMs": 629630,
      "endMs": 635460,
      "durationMs": 5830,
      "transition": "none",
      "text": "jenderalnya yang bergelar Diadochi berebut wilayah dalam perang saudara panjang."
    },
    {
      "index": 129,
      "id": 129,
      "image": "yunani/scene-129.jpg",
      "startMs": 635460,
      "endMs": 639330,
      "durationMs": 3870,
      "transition": "none",
      "text": "Dari puing kekaisaran itu, terbentuk tiga dinasti besar: Ptolemeus di"
    },
    {
      "index": 130,
      "id": 130,
      "image": "yunani/scene-130.jpg",
      "startMs": 639330,
      "endMs": 645970,
      "durationMs": 6640,
      "transition": "none",
      "text": "Mesir, Seleukia di Timur Dekat, dan Antigonid di Makedonia."
    },
    {
      "index": 131,
      "id": 131,
      "image": "yunani/scene-131.jpg",
      "startMs": 645970,
      "endMs": 651030,
      "durationMs": 5060,
      "transition": "none",
      "text": "Inilah era Helenistik. Kedaulatan politik negara-kota telah sirna,"
    },
    {
      "index": 132,
      "id": 132,
      "image": "yunani/scene-132.jpg",
      "startMs": 651030,
      "endMs": 655490,
      "durationMs": 4460,
      "transition": "none",
      "text": "tetapi denyut kebudayaannya menyebar ke seluruh penjuru bumi."
    },
    {
      "index": 133,
      "id": 133,
      "image": "yunani/scene-133.jpg",
      "startMs": 655490,
      "endMs": 661440,
      "durationMs": 5950,
      "transition": "none",
      "text": "Dialek bahasa Yunani sederhana bernama Koine menjadi bahasa pengantar pergaulan"
    },
    {
      "index": 134,
      "id": 134,
      "image": "yunani/scene-134.jpg",
      "startMs": 661440,
      "endMs": 665240,
      "durationMs": 3800,
      "transition": "none",
      "text": "internasional dari Laut Mediterania sampai India. Di perpustakaan Alexandria, para"
    },
    {
      "index": 135,
      "id": 135,
      "image": "yunani/scene-135.jpg",
      "startMs": 665240,
      "endMs": 671880,
      "durationMs": 6640,
      "transition": "none",
      "text": "sarjana menyusun dasar ilmu ukur geometri dan menghitung keliling bumi."
    },
    {
      "index": 136,
      "id": 136,
      "image": "yunani/scene-136.jpg",
      "startMs": 671880,
      "endMs": 675720,
      "durationMs": 3840,
      "transition": "none",
      "text": "Jauh di pedalaman Asia Tengah, tepatnya di situs Ai"
    },
    {
      "index": 137,
      "id": 137,
      "image": "yunani/scene-137.jpg",
      "startMs": 675720,
      "endMs": 678340,
      "durationMs": 2620,
      "transition": "none",
      "text": "Khanoum di tepi Sungai Oxus di Afghanistan modern,"
    },
    {
      "index": 138,
      "id": 138,
      "image": "yunani/scene-138.jpg",
      "startMs": 678340,
      "endMs": 683260,
      "durationMs": 4920,
      "transition": "none",
      "text": "para arkeolog menemukan reruntuhan kota Yunani lengkap dengan teater terbuka,"
    },
    {
      "index": 139,
      "id": 139,
      "image": "yunani/scene-139.jpg",
      "startMs": 683260,
      "endMs": 687060,
      "durationMs": 3800,
      "transition": "none",
      "text": "gimnasium, dan pilar batu bergaya Korintus. Di makam pendiri"
    },
    {
      "index": 140,
      "id": 140,
      "image": "yunani/scene-140.jpg",
      "startMs": 687060,
      "endMs": 691980,
      "durationMs": 4920,
      "transition": "none",
      "text": "kota terpahat untaian pepatah dari Kuil Delphi di Yunani"
    },
    {
      "index": 141,
      "id": 141,
      "image": "yunani/scene-141.jpg",
      "startMs": 691980,
      "endMs": 697080,
      "durationMs": 5100,
      "transition": "none",
      "text": "yang mengajarkan manusia belajar sopan santun di masa kecil,"
    },
    {
      "index": 142,
      "id": 142,
      "image": "yunani/scene-142.jpg",
      "startMs": 697080,
      "endMs": 702100,
      "durationMs": 5020,
      "transition": "none",
      "text": "menguasai emosi di masa muda, berlaku adil di masa dewasa,"
    },
    {
      "index": 143,
      "id": 143,
      "image": "yunani/scene-143.jpg",
      "startMs": 702100,
      "endMs": 708350,
      "durationMs": 6250,
      "transition": "none",
      "text": "memberi nasihat bijak di masa tua, dan menghadapi maut tanpa"
    },
    {
      "index": 144,
      "id": 144,
      "image": "yunani/scene-144.jpg",
      "startMs": 708350,
      "endMs": 710570,
      "durationMs": 2220,
      "transition": "none",
